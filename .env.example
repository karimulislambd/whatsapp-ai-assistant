# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_your_key_here

# --- WhatsApp Cloud API (Meta developer app -> WhatsApp -> API Setup) ---
# Temporary (24h) or permanent System User access token
WHATSAPP_TOKEN=EAAG...
# "Phone number ID" of the sending number (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any random string you choose; paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
# App settings -> Basic -> App secret (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_app_secret

# --- Storage ---
DB_PATH=data/assistant.db

# --- Optional overrides (defaults shown) ---
# GRAPH_API_VERSION=v21.0
# CHAT_MODEL=llama-3.3-70b-versatile
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# WHISPER_MODEL=whisper-large-v3
# MEMORY_TURNS=10
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_SECONDS=600
# LOG_LEVEL=INFO
